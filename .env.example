# Server-only. Never prefix the service role key with NEXT_PUBLIC_.
# The browser is not given a Supabase key.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used in Stripe return URLs and email links.
# Example: https://pilot.example.com  or  http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Stripe TEST mode only. The app rejects keys that do not start with sk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend. RESEND_FROM must be on a domain you have verified in Resend.
# Example: Sweet Success Fundraising <hello@sweetsuccessfundraising.com>
RESEND_API_KEY=
RESEND_FROM=

# Admin notices (application copy, out-of-area). No mail is sent here when this is empty.
# Preview: set this to the Resend test address. Never a personal Gmail.
# Live inbox: the team inbox, once team.sweetsuccessfundraising.com is approved.
ADMIN_EMAIL=

# Apply emails stay off until this is true, 1, or yes. Missing Resend key also sends nothing.
# A set EMAIL_TEST_RECIPIENT also allows these sends, and redirects them.
APPLY_EMAILS_ENABLED=

# Optional. When set, every email is sent only to this address.
# The subject is prefixed with "[TEST to <original recipient>] ".
# Apply emails send even if APPLY_EMAILS_ENABLED is off. Still needs RESEND_API_KEY.
EMAIL_TEST_RECIPIENT=

# Password for /admin (httpOnly cookie). Use a long random value.
ADMIN_PASSWORD=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET.
# Used by /api/cron/milestones and /api/cron/prospects. Needed on Preview.
CRON_SECRET=

# Signs start, unsubscribe, and roster links. Needed on Preview before those emails go out.
ORGANIZER_ACTION_SECRET=

# Reply inbox. Leave unset or false on Preview until DNS for team.sweetsuccessfundraising.com is approved.
# When off, prospect emails have no Reply-To header.
INBOUND_EMAIL_ENABLED=

# Host for Reply-To addresses when inbound email is on. Defaults to team.sweetsuccessfundraising.com.
# Not needed on Preview while INBOUND_EMAIL_ENABLED is off.
INBOUND_REPLY_DOMAIN=

# Verifies the Resend inbound webhook. Only needed when INBOUND_EMAIL_ENABLED is on.
RESEND_INBOUND_WEBHOOK_SECRET=
