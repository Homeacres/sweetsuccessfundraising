# Server-only. Never prefix the service role key with NEXT_PUBLIC_.
# The browser is not given a Supabase key.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used in Stripe return URLs and email links.
# Example: https://pilot.example.com  or  http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Stripe TEST mode only. The app rejects keys that do not start with sk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend. RESEND_FROM must be on a domain you have verified in Resend.
# Example: Sweet Success Fundraising <hello@sweetsuccessfundraising.com>
RESEND_API_KEY=
RESEND_FROM=

# Organizer applications are emailed here. If empty, the copy goes to obrien71@gmail.com.
ADMIN_EMAIL=

# Apply emails stay off until this is true, 1, or yes. Missing Resend key also sends nothing.
# A set EMAIL_TEST_RECIPIENT also allows these sends, and redirects them.
APPLY_EMAILS_ENABLED=

# Optional. When set, every email is sent only to this address.
# The subject is prefixed with "[TEST to <original recipient>] ".
# Apply emails send even if APPLY_EMAILS_ENABLED is off. Still needs RESEND_API_KEY.
EMAIL_TEST_RECIPIENT=

# Password for /admin (httpOnly cookie). Use a long random value.
ADMIN_PASSWORD=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=
